# ============================================================================
#  Copy to .env.local (local dev) or set these in your host's dashboard
#  (Vercel -> Project -> Settings -> Environment Variables). NEVER commit real values.
# ============================================================================

# ---- Database -------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/freetv?retryWrites=true&w=majority

# ---- Admin ----------------------------------------------------------------
# Required in production (admin routes fail closed without it). Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=

# Cron authentication for vercel.json's scheduled jobs (/api/admin/scheduler/*).
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` automatically for
# cron requests, so set it in the project's Environment Variables and the crons
# fire with no extra work. Without it the schedule still runs but every call is
# rejected with 401, so nothing is checked. Generate one the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# vercel.json runs exactly one cron: the playlist sync at 20:00 UTC. The health
# checks are NOT Vercel crons — they run in GitHub Actions
# (.github/workflows/soluplay-health-check.yml, every 4 hours) and call
# /api/admin/health-check directly, so they need no CRON_SECRET.
# The sync cron's hour must match SYNC_HOUR_UTC in lib/playlistMonitor.ts (20 = 20:00 UTC).
CRON_SECRET=

# ---- Stream box (the premium tier) ------------------------------------------
# Where the box that holds the premium stream credentials lives, and the two
# service tokens it accepts. All three are server-side only — a browser must
# never hold either token, because the whole point of the split is that a signed
# playlist URL is minted here and the signing secret never leaves this server.
# Without them the premium admin's "push" fails closed with these names and the
# Direct HLS catalogue is unaffected.
#   PROXY_BASE_URL  — the box's own address, e.g. https://<your-named-tunnel> or
#                     http://127.0.0.1:8080 for the local end-to-end run. No path.
#   PROXY_ADMIN_TOKEN  — registers and removes sources (ADMIN_SERVICE_TOKEN there).
#   PROXY_APP_TOKEN    — signs short-lived entry URLs (APP_SERVICE_TOKEN there).
#   PROXY_READONLY_TOKEN — reads the box's inspection surface only
#                     (READONLY_SERVICE_TOKEN there). The 24/7 proxy control panel
#                     needs it to show the vault's readiness, the providers, the
#                     channels and the lane counters. It can read and change nothing:
#                     the box refuses every write method on that surface, and the
#                     token is not accepted anywhere else on the box.
PROXY_BASE_URL=
PROXY_ADMIN_TOKEN=
PROXY_APP_TOKEN=
PROXY_READONLY_TOKEN=

# ---- Misc -----------------------------------------------------------------
YOUTUBE_API_KEY=
NEXT_PUBLIC_ENABLE_ADS=false
