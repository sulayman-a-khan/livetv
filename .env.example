# ============================================================================
#  Copy to .env.local (local dev) or set these in your host's dashboard
#  (Vercel -> Project -> Settings -> Environment Variables). NEVER commit real values.
# ============================================================================

# ---- Database -------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/freetv?retryWrites=true&w=majority

# ---- Admin ----------------------------------------------------------------
# Required in production (admin routes fail closed without it). Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=

# Cron authentication for vercel.json's scheduled jobs (/api/admin/scheduler/*).
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` automatically for
# cron requests, so set it in the project's Environment Variables and the crons
# fire with no extra work. Without it the schedule still runs but every call is
# rejected with 401, so nothing is checked. Generate one the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# vercel.json runs one sync at 20:00 UTC plus four health passes (03/09/15/21).
# Every expression runs once per day on purpose: Hobby rejects a cron schedule
# that fires more often, and "0 */6 * * *" would fail the whole deployment.
# The sync cron's hour must match SYNC_HOUR_UTC in lib/playlistMonitor.ts (20 = 20:00 UTC).
CRON_SECRET=

# ---- Misc -----------------------------------------------------------------
YOUTUBE_API_KEY=
NEXT_PUBLIC_ENABLE_ADS=false
