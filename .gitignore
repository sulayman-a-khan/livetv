.env*
# ...except the committed template, which holds placeholders only (no secrets).
!.env.example
scratch_channels.json

# Runtime data — local JSON mirror of channels + stream links. Holds live
# origin URLs and health state, so it stays out of the public repository.
# lib/inMemoryStore.ts recreates it automatically when it is missing.
/data/store.json

# Temporary local-testing capture of the production catalogue, and the store
# it is loaded into. Both are local-only: the capture is taken through the
# public API and must never reach the repository or a deployment.
/data/prod-snapshot.json
/data/store.snapshot.json

# Throwaway verification scripts
/.tmp-verify

# Compiled output of `npm run test:ranking` (see tsconfig.tests.json)
/.tmp-tests

# TypeScript incremental build cache — regenerated by every tsc/next build, so
# tracking it only keeps the working tree permanently dirty.
*.tsbuildinfo
