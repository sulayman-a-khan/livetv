{
  "name": "freetv",
  "version": "1.0.0",
  "private": true,
  "browserslist": [
    "chrome >= 38",
    "samsung >= 4",
    "safari >= 9",
    "edge >= 13",
    "ios >= 9",
    "firefox >= 40",
    "opera >= 25",
    "android >= 5"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:ranking": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/ranking.test.js",
    "test:link-registration": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/ranking.test.js .tmp-tests/tests/link-registration.test.js",
    "test:ssrf-guard": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/ssrf-guard.test.js .tmp-tests/tests/safe-fetch.test.js",
    "test:premium-fixtures": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/premium-fixtures.test.js",
    "test:premium-readiness": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/premium-readiness.test.js",
    "test:premium-store": "tsc -p tsconfig.tests.json --noCheck && node --test .tmp-tests/tests/premium-store.test.js",
    "test:premium-box": "node scripts/premium-box-e2e.mjs",
    "check:health-workflow": "node scripts/verify-health-check-workflow.mjs",
    "check:packaging": "node scripts/verify-packaging-secrets.mjs",
    "snapshot:production": "node scripts/snapshot-production-catalogue.mjs",
    "dev:snapshot": "node scripts/run-with-snapshot.mjs next dev"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "hls.js": "^1.5.15",
    "lucide-react": "^0.439.0",
    "mongoose": "^8.6.1",
    "mpegts.js": "^1.8.2",
    "next": "^14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
