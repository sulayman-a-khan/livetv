{
  "//": "Compiles the pure ranking rules plus tests/ into .tmp-tests so Node's own test runner can execute them. Type checking is the project's own `npx tsc --noEmit`.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "esnext"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app/api/admin/proxy/session/route.ts",
    "app/api/admin/proxy/status/route.ts",
    "lib/adminAuth.ts",
    "lib/channelIdentity.ts",
    "lib/channelMaintenance.ts",
    "lib/fixtureBoard.ts",
    "lib/premiumFixtures.ts",
    "lib/proxyControl.ts",
    "lib/safeFetch.ts",
    "lib/ssrfGuard.ts",
    "lib/streamHealth.ts",
    "tests/**/*.ts"
  ]
}
