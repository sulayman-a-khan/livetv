{
  "//": "Compiles the pure ranking rules plus tests/ into .tmp-tests so Node's own test runner can execute them. The compiler options mirror the app's own tsconfig.json, so this compile is a real type check and not only an emit: a type error in a test file fails it.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "app/api/admin/fixtures/[id]/route.ts",
    "app/api/admin/proxy/inspect/route.ts",
    "app/api/admin/proxy/session/route.ts",
    "app/api/admin/proxy/status/route.ts",
    "app/api/premium/[id]/play/route.ts",
    "components/proxy-admin/proxyBanner.ts",
    "lib/adminAuth.ts",
    "lib/channelMaintenance.ts",
    "lib/channelIdentity.ts",
    "lib/db.ts",
    "lib/fixtureBoard.ts",
    "lib/fixtureSources.ts",
    "lib/inMemoryStore.ts",
    "lib/premiumFixtures.ts",
    "lib/premiumLocalStore.ts",
    "lib/premiumPlayFailure.ts",
    "lib/premiumReadiness.ts",
    "lib/premiumStore.ts",
    "lib/proxyControl.ts",
    "lib/streamHealth.ts",
    "lib/ssrfGuard.ts",
    "lib/safeFetch.ts"
  ]
}
