{
  "//": "Compiles the pure ranking rules plus tests/ into .tmp-tests so Node's own test runner can execute them. The compiler options mirror the app's own tsconfig.json, so this compile is a real type check and not only an emit: a type error in a test file fails it.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "app/api/admin/fixtures/route.ts",
    "app/api/admin/fixtures/[id]/route.ts",
    "app/api/admin/premium/channels/route.ts",
    "app/api/admin/premium/channels/[id]/route.ts",
    "app/api/admin/premium/live/route.ts",
    "app/api/admin/premium/providers/route.ts",
    "app/api/admin/premium/providers/[id]/route.ts",
    "app/api/admin/premium/providers/[id]/channels/route.ts",
    "app/api/youtube/resolve/route.ts",
    "app/api/admin/proxy/action/route.ts",
    "app/api/admin/proxy/inspect/route.ts",
    "app/api/admin/proxy/session/route.ts",
    "app/api/admin/proxy/status/route.ts",
    "app/api/admin/proxy/boxes/route.ts",
    "app/api/admin/proxy/boxes/[id]/revoke/route.ts",
    "app/api/premium/[id]/play/route.ts",
    "app/api/proxy/box/enroll/route.ts",
    "app/api/proxy/box/register/route.ts",
    "components/proxy-admin/proxyActionLabels.ts",
    "components/proxy-admin/proxyBanner.ts",
    "components/premium-admin/providerChannelPick.ts",
    "lib/adminAuth.ts",
    "lib/boxRegistry.ts",
    "lib/channelMaintenance.ts",
    "lib/channelIdentity.ts",
    "lib/db.ts",
    "lib/fixtureBoard.ts",
    "lib/fixtureSources.ts",
    "lib/inMemoryStore.ts",
    "lib/premiumFixtures.ts",
    "lib/premiumBoxSync.ts",
    "lib/premiumLocalStore.ts",
    "lib/premiumPlayFailure.ts",
    "lib/premiumProxy.ts",
    "lib/premiumReadiness.ts",
    "lib/premiumStore.ts",
    "lib/proxyActions.ts",
    "lib/proxyControl.ts",
    "lib/streamHealth.ts",
    "lib/ssrfGuard.ts",
    "lib/safeFetch.ts",
    "lib/teamFlags.ts",
    "lib/youtube.ts",
    "lib/youtubeResolveGuard.ts",
    "middleware.ts"
  ]
}
