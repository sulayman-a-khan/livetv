{
  "//": "Compiles the pure ranking rules plus tests/ into .tmp-tests so Node's own test runner can execute them. The compiler options mirror the app's own tsconfig.json, so this compile is a real type check and not only an emit: a type error in a test file fails it. Only the app's own modules are listed here — the files under tests/ plus the ones the tested code reaches.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "app/api/admin/fixtures/route.ts",
    "app/api/admin/fixtures/[id]/route.ts",
    "app/api/admin/fixtures/sources/route.ts",
    "app/api/app/favourites/route.ts",
    "app/api/fixtures/route.ts",
    "app/api/youtube/resolve/route.ts",
    "lib/adminAuth.ts",
    "lib/appRelease.ts",
    "lib/browserGate.ts",
    "lib/browserTrustFetch.ts",
    "lib/channelMaintenance.ts",
    "lib/channelIdentity.ts",
    "lib/db.ts",
    "lib/favouriteList.ts",
    "lib/favourites.ts",
    "lib/fixtureBoard.ts",
    "lib/fixtureSources.ts",
    "lib/fixtureStore.ts",
    "lib/fixtures.ts",
    "lib/inMemoryStore.ts",
    "lib/streamHealth.ts",
    "lib/ssrfGuard.ts",
    "lib/safeFetch.ts",
    "lib/siteOrigin.ts",
    "lib/streamProbe.ts",
    "lib/teamFlags.ts",
    "lib/validation.ts",
    "lib/youtube.ts",
    "lib/youtubeResolveGuard.ts",
    "middleware.ts"
  ]
}
