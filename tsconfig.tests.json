{
  "//": "Compiles the pure ranking rules plus tests/ into .tmp-tests so Node's own test runner can execute them. Type checking is the project's own `npx tsc --noEmit`.",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["esnext"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "app/api/admin/proxy/inspect/route.ts",
    "app/api/admin/proxy/session/route.ts",
    "app/api/admin/proxy/status/route.ts",
    "lib/adminAuth.ts",
    "lib/channelMaintenance.ts",
    "lib/channelIdentity.ts",
    "lib/db.ts",
    "lib/fixtureBoard.ts",
    "lib/fixtureSources.ts",
    "lib/inMemoryStore.ts",
    "lib/premiumFixtures.ts",
    "lib/premiumLocalStore.ts",
    "lib/premiumReadiness.ts",
    "lib/premiumStore.ts",
    "lib/proxyControl.ts",
    "lib/streamHealth.ts",
    "lib/ssrfGuard.ts",
    "lib/safeFetch.ts"
  ]
}
